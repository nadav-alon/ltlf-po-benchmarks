#G (p -> F q) && G (r -> F s) <-> G (F acc)
#(! ((! (((F (! ((! p) || (F q)))) || (F (! ((! r) || (F s))))) || (! (F (! (F acc)))))) || (! ((F (! (F acc))) || (! ((F (! ((! p) || (F q)))) || (F (! ((! r) || (F s))))))))))
#NNF format
#((((F (p && (G (! q)))) || (F (r && (G (! s))))) || (G (F acc))) && ((F (G (! acc))) || ((G ((! p) || (F q))) && (G ((! r) || (F s))))))
m2l-str;
var2 ACC, P, Q, R, S;
(((((((all1 x1: ((0 <= x1) => ((((ex1 x2: (x1 <= x2 & ((x2 in S))))) | (~((x1 in R)))))))) & ((all1 x1: ((0 <= x1) => ((((ex1 x2: (x1 <= x2 & ((x2 in Q))))) | (~((x1 in P)))))))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in ACC))))))))))) & ((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in ACC)))))))) | ((((ex1 x1: (0 <= x1 & ((((all1 x2: ((x1 <= x2) => (~((x2 in S)))))) & ((x1 in R))))))) | ((ex1 x1: (0 <= x1 & ((((all1 x2: ((x1 <= x2) => (~((x2 in Q)))))) & ((x1 in P))))))))))));
