#G (F req) || F cancel -> G (F grant) || G ack
#((! ((! (F (! (F req)))) || (F cancel))) || ((! (F (! (F grant)))) || (! (F (! ack)))))
#NNF format
#(((F (G (! req))) && (G (! cancel))) || ((G (F grant)) || (G ack)))
m2l-str;
var2 ACK, CANCEL, GRANT, REQ;
(((((all1 x1: ((0 <= x1) => ((x1 in ACK))))) | ((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in GRANT)))))))))) | ((((all1 x1: ((0 <= x1) => (~((x1 in CANCEL)))))) & ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in REQ))))))))))));
