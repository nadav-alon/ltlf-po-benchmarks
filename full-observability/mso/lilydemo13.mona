#(G r1 -> F a1) && (G (! r1) -> F (! a1))
#(! ((! ((F (! r1)) || (F a1))) || (! ((F r1) || (F (! a1))))))
#NNF format
#(((F (! r1)) || (F a1)) && ((F r1) || (F (! a1))))
m2l-str;
var2 A1, R1;
(((((ex1 x1: (0 <= x1 & (~((x1 in A1)))))) | ((ex1 x1: (0 <= x1 & ((x1 in R1))))))) & ((((ex1 x1: (0 <= x1 & ((x1 in A1))))) | ((ex1 x1: (0 <= x1 & (~((x1 in R1)))))))));
