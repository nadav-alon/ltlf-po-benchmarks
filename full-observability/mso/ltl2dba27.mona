#F (G (! p)) <-> G (F acc)
#(! ((! ((! (F (! (F p)))) || (! (F (! (F acc)))))) || (! ((F (! (F acc))) || (F (! (F p)))))))
#NNF format
#(((G (F p)) || (G (F acc))) && ((F (G (! acc))) || (F (G (! p)))))
m2l-str;
var2 ACC, P;
(((((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in P))))))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in ACC))))))))))) & ((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in ACC)))))))) | ((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in P)))))))))));
