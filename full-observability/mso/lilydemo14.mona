#G (! (g0 && g1)) && (G (F r0) -> G (F g0)) && (G (F r1) -> G (F g1))
#(! (((F (! ((! g0) || (! g1)))) || (! ((F (! (F r0))) || (! (F (! (F g0))))))) || (! ((F (! (F r1))) || (! (F (! (F g1))))))))
#NNF format
#(((G ((! g0) || (! g1))) && ((F (G (! r0))) || (G (F g0)))) && ((F (G (! r1))) || (G (F g1))))
m2l-str;
var2 G0, G1, R0, R1;
(((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in G1)))))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in R1))))))))))) & ((((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in G0)))))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in R0))))))))))) & ((all1 x1: ((0 <= x1) => (((~((x1 in G1))) | (~((x1 in G0)))))))))));
