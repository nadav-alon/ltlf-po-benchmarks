#G (F req) -> G ((! grant -> (! grant U req)) && (req -> F grant)) && ! grant && G (F grant)
#((F (! (F req))) || (! (((F ((! (grant || ((! grant) U req))) || (! ((! req) || (F grant))))) || grant) || (F (! (F grant))))))
#NNF format
#((F (G (! req))) || (((G ((grant || ((! grant) U req)) && ((! req) || (F grant)))) && (! grant)) && (G (F grant))))
m2l-str;
var2 GRANT, REQ;
(((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in GRANT)))))))) & (((~((0 in GRANT))) & ((all1 x1: ((0 <= x1) => ((((((ex1 x2: (x1 <= x2 & ((x2 in GRANT))))) | (~((x1 in REQ))))) & ((((ex1 x2: (x1 <= x2 & ((x2 in REQ)) & (all1 x3: (x1 <= x3 & x3 < x2 => (~((x3 in GRANT)))))))) | ((x1 in GRANT))))))))))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in REQ))))))))));
