#G p <-> G (F acc)
#(! ((! ((F (! p)) || (! (F (! (F acc)))))) || (! ((F (! (F acc))) || (! (F (! p)))))))
#NNF format
#(((F (! p)) || (G (F acc))) && ((F (G (! acc))) || (G p)))
m2l-str;
var2 ACC, P;
(((((all1 x1: ((0 <= x1) => ((x1 in P))))) | ((ex1 x1: (0 <= x1 & ((all1 x2: ((x1 <= x2) => (~((x2 in ACC))))))))))) & ((((all1 x1: ((0 <= x1) => ((ex1 x2: (x1 <= x2 & ((x2 in ACC)))))))) | ((ex1 x1: (0 <= x1 & (~((x1 in P)))))))));
